{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@schema/*": ["./schema/*"],
      "@domain/*": ["./domain/*"]
    }
  },
  "include": ["scripts", "schema", "domain"]
}
